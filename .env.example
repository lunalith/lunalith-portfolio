# Template de variáveis de ambiente.
# Copie para .env.local (que está no .gitignore) e preencha os valores.
# Nunca commite o .env.local nem cole segredos aqui.

# --- Sanity ---------------------------------------------------------------
# Encontre o projectId em https://sanity.io/manage, no projeto criado.
# São públicas por design (prefixo NEXT_PUBLIC_): identificam um dataset de
# leitura pública, não dão acesso de escrita. Quem edita entra no /studio com
# a própria conta do Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Opcional. Sem valor, o código usa a data fixa definida em sanity/env.ts.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# --- Site -----------------------------------------------------------------
# Domínio final, usado para montar as URLs absolutas de Open Graph e sitemap.
# Na Vercel, defina com o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=https://lunalith.dev
